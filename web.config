<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Disable IIS handlers -->
        <handlers>
            <clear />
        </handlers>

        <!-- URL Rewrite Rules -->
        <rewrite>
            <rules>
                <!-- Proxy everything to FastAPI -->
                <rule name="ReverseProxyInboundRule" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:50100/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <!-- Pass backend errors to the client -->
        <httpErrors existingResponse="PassThrough" />

        <!-- Allow the proxy to work properly -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="4294967295" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
