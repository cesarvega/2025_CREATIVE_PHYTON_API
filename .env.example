# Environment Configuration
# Set to "production" for production deployment, "development" for local development
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=50100

# Application Configuration
APP_NAME=Report Generator API
APP_VERSION=2.0.0
DEBUG=false

# CORS Configuration
CORS_ORIGINS=*
CORS_METHODS=*
CORS_HEADERS=*

# Database Configuration
# SQL Server connection string for BI_GUIDELINES database
SQL_CONNECTION_STRING=DRIVER={SQL Server};SERVER=your_server;DATABASE=your_database;UID=your_username;PWD=your_password;TrustServerCertificate=yes;Connection Timeout=30;Encrypt=no;

# Logging Configuration
LOG_LEVEL=INFO
